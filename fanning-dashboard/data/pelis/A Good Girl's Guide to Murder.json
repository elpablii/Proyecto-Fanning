    "episodes": {
      "S01E01": {
        "name": "Episode 1",
        "still_path": "https://image.tmdb.org/t/p/w500/yWIUI4Qqac5oEfmHeXmQk0VuATB.jpg",
        "overview": "Pip elige un caso de homicidio para su proyecto escolar. Pero cuando empieza a investigar, descubre que para algunas personas era mejor dejarlo enterrado para siempre."
      },
      "S01E02": {
        "name": "Episode 2",
        "still_path": "https://image.tmdb.org/t/p/w500/vTuMceHI6Uxi6hVCTxFwquDKMxv.jpg",
        "overview": "Luego de entrevistar a las mejores amigas de Andie, Pip tiene una idea más clara de quién era la víctima, pero tras reorganizar fotos viejas empieza a comprender mejor todo."
      },
      "S01E03": {
        "name": "Episode 3",
        "still_path": "https://image.tmdb.org/t/p/w500/sEBwyQKWVwbw3SlP8JnpIzVBkRe.jpg",
        "overview": "Pip descubre por primera vez en su vida el lado oscuro cuando va a una fiesta clandestina. Y su siguiente pista la lleva a territorio aún más peligroso."
      },
      "S01E04": {
        "name": "Episode 4",
        "still_path": "https://image.tmdb.org/t/p/w500/zF4TRU2CgLRjchc2oWFgqp1NHYv.jpg",
        "overview": "Pip y Ravi siguen una nueva pista que los lleva lejos de Little Kilton. Allí, descubren una valiosa prueba... y una desagradable sorpresa."
      },
      "S01E05": {
        "name": "Episode 5",
        "still_path": "https://image.tmdb.org/t/p/w500/uBqP6OOmqp7fkDKpTVcvYsSq1KF.jpg",
        "overview": "Una impactante confesión arroja luz en la investigación. Antes de que Pip pueda decidir qué hacer, recibe otro mensaje amenazador."
      },
      "S01E06": {
        "name": "Episode 6",
        "still_path": "https://image.tmdb.org/t/p/w500/37aueb8rEyPyouLinzokTiaja6j.jpg",
        "overview": "La policía hace un arresto, pero Pip no está segura de que el caso esté solucionado, así que va a visitar a la única persona que podría tener respuestas."
      }
    }
